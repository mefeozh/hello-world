# Runtime overrides — copy to .env and fill in
UVR_DIR=C:\Users\YourName\AppData\Local\Programs\Ultimate Vocal Remover
MODEL_DIR=C:\Users\YourName\AppData\Local\Programs\Ultimate Vocal Remover\models
LIBRARY_DIR=library

